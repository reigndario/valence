# Postgres (local dev — matches infra/docker-compose.yml)
DATABASE_URL=postgres://valence:valence@localhost:5432/valence?sslmode=disable

# Redis (local dev)
REDIS_URL=redis://localhost:6379

# apps/api
PORT=8080

# apps/workbench — where to reach apps/api (server-side and client-side respectively)
VALENCE_API_URL=http://localhost:8080
NEXT_PUBLIC_VALENCE_API_URL=http://localhost:8080

# apps/workbench — shared-secret auth gate (P2-08); required for any deployed environment,
# optional for local dev (middleware fails open when unset and NODE_ENV !== production)
WORKBENCH_SHARED_SECRET=change-me
